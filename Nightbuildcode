    ToggleBtn.BackgroundTransparency = 1
    ToggleBtn.Text = ""
    local Layout = Instance.new("UIListLayout", Frame)
    Layout.Padding = UDim.new(0, 4)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    local open = false
    ToggleBtn.MouseButton1Click:Connect(function()
        open = not open
        local targetHeight = open and (45 + (#options * 34) + 5) or 45
        TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, targetHeight)}):Play()
    end)
    for i, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton", Frame)
        OptBtn.Size = UDim2.new(1, -20, 0, 30)
        OptBtn.BackgroundColor3 = Theme.Hover
        OptBtn.Text = tostring(opt)
        OptBtn.TextColor3 = Theme.TextDim
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.TextSize = 13
        OptBtn.LayoutOrder = i
        Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 4)
        OptBtn.MouseButton1Click:Connect(function()
            Label.Text = text .. ": " .. tostring(opt)
            open = false
            TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
            callback(opt)
        end)
    end
end

